{
	"name": "omnipin",
	"version": "3.1.3",
	"author": "v1rtl <hi@v1rtl.site>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/omnipin/omnipin.git"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.7",
		"@ipld/car": "^5.4.2",
		"@ipld/dag-pb": "^4.1.7",
		"@jsr/omnipin__foc": "^0.0.20",
		"@multiformats/murmur3": "^2.2.5",
		"@omnipin/foc": "npm:@jsr/omnipin__foc@0.0.20",
		"@rslib/core": "^0.23.2",
		"@size-limit/file": "^12.0.1",
		"@stauro/filebase-upload": "npm:@jsr/stauro__filebase-upload",
		"@types/node": "^26.2.0",
		"@types/varint": "^6.0.3",
		"hamt-sharding": "^3.0.8",
		"interface-blockstore": "^7.0.1",
		"interface-store": "^8.0.0",
		"ipfs-unixfs": "^13.0.0",
		"multiformats": "^14.0.0",
		"nanotar": "^0.3.0",
		"ox": "^0.14.8",
		"prool": "^0.2.4",
		"size-limit": "^12.0.1",
		"spektr": "^0.2.0",
		"tinyglobby": "^0.2.15",
		"typescript": "^7.0.2",
		"varint": "^6.0.0"
	},
	"bin": {
		"omnipin": "dist/index.js"
	},
	"description": "🌸 Self-custodial decentralized deployments",
	"engineStrict": true,
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist"
	],
	"homepage": "https://github.com/omnipin/omnipin",
	"keywords": [
		"ipfs",
		"filecoin",
		"deploy",
		"cli"
	],
	"license": "MIT",
	"packageManager": "pnpm@12.11.2",
	"release": {
		"branches": [
			"main"
		]
	},
	"scripts": {
		"build": "rslib",
		"prepublishOnly": "pnpm build && size-limit",
		"check": "biome check",
		"types": "tsc --noEmit",
		"test": "node --experimental-test-module-mocks --import ./test/register.ts --test 'test/**/*.test.ts'",
		"test:report": "mkdir -p coverage && node --experimental-test-module-mocks --import ./test/register.ts --test --experimental-test-coverage --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'test/**/*.test.ts'",
		"test:e2e": "node --import ./test/register.ts --test 'e2e/**/*.test.ts'"
	},
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "1MB",
			"brotli": false
		}
	],
	"type": "module"
}
